# 默认让 Git 自动检测文本文件并在仓库中统一存储为 LF。
* text=auto

# 以下类型强制在工作区也使用 LF：
# Go 的 gofmt、Shell 脚本与 YAML 都对 CRLF 敏感（gofmt -l 会把 CRLF 文件列为未格式化）。
*.go        text eol=lf
*.mod       text eol=lf
*.sum       text eol=lf
*.sh        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.gradle    text eol=lf
*.pro       text eol=lf
*.patch     text eol=lf
*.properties text eol=lf
.gitmodules text eol=lf
*.xml       text eol=lf
Dockerfile  text eol=lf
*.service   text eol=lf

# Windows 专用脚本保持 CRLF。
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.iss       text eol=crlf

# 二进制文件不做行尾转换，也不参与 diff。
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.svgz      binary
*.so        binary
*.dll       binary
*.exe       binary
*.dylib     binary
*.a         binary
*.jar       binary
*.aar       binary
*.keystore  binary
*.jks       binary
*.apk       binary
*.aab       binary
*.zip       binary
*.gz        binary
*.7z        binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
