# ---- 通用 ----
*.log
*.tmp
.DS_Store
Thumbs.db
# CI 的 staging 目录（Android CI 把 APK 拷到仓库根的 artifacts/）
/artifacts/

# ---- 机密 ----
# 绝不提交凭据、私钥、签名文件
*.keystore
*.jks
*.pfx
*.p12
*.pem
*.key
config.yaml
config.yml
config.local.*
.env
.env.*
!config.example.yaml
!.env.example

# ---- Android ----
# client/mobile 是 git submodule，其忽略规则由子仓库自己的 .gitignore 管理。
# 这里不需要（也不应该）重复列出它的构建产物。

# ---- TeamSpeak 官方服务端 (不入库) ----
# tsserver 及其附带文档是 TeamSpeak Systems 的专有软件，其许可协议第 7.3 条禁止
# 复制与再分发（"reproducing ... or otherwise making available in whole or in parts"）。
# 本仓库只在本地保留它们用于开发测试，不提交、不推送。
# 获取方式见 docs/deploy/stream-service.md。
server/win/
server/linux/

# ---- Go (server/ts9-stream) ----
server/ts9-stream/ts9-stream
server/ts9-stream/ts9-stream.exe
server/ts9-stream/dist/
server/ts9-stream/*.test
server/ts9-stream/coverage.out

# ---- .NET (client/desktop) ----
client/desktop/**/bin/
client/desktop/**/obj/
client/desktop/.vs/
client/desktop/TestResults/
client/desktop/artifacts/
*.user
*.suo

# ---- 原生二进制 (不入库, 见 third_party/native/README.md) ----
client/desktop/third_party/native/**/*.dll
client/desktop/third_party/native/**/*.so

# ---- 编辑器 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.codegraph/
