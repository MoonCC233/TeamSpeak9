<controls:ShellWindow x:Class="TeamSpeak9.App.Views.SharePickerWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
                      xmlns:controls="clr-namespace:TeamSpeak9.App.Controls"
                                            xmlns:conv="clr-namespace:TeamSpeak9.App.Converters"
                                            Title="共享屏幕"
                      Width="640"
                      Height="520"
                      MinWidth="520"
                      MinHeight="400"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">

  <controls:ShellWindow.Resources>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
    </controls:ShellWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Same caption arrangement as the shell: Windows owns the strip, only the buttons opt back
         in to hit testing. -->
    <Grid Grid.Row="0"
          Height="{StaticResource Size.CaptionHeight}"
          Background="{StaticResource Brush.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="共享屏幕"
                 Style="{StaticResource Text.Subtitle}"
                 VerticalAlignment="Center"
                 Margin="14,0,0,0" />

      <Button Grid.Column="1"
              Style="{StaticResource Button.CaptionClose}"
              Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
              VerticalAlignment="Top"
              Margin="0,8,8,0"
              ToolTip="关闭">
        <controls:IconGlyph Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}" />
      </Button>
    </Grid>

    <!-- ===== Target list ===== -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="14,12,14,0">

        <TextBlock Text="选择要共享的内容"
                   Style="{StaticResource Text.Body}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <!-- Empty hint -->
        <TextBlock Text="没有可共享的显示器或窗口。"
                   Style="{StaticResource Text.Body}"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />

        <!-- Displays -->
        <ItemsControl ItemsSource="{Binding Displays}"
                      Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisible}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton GroupName="ShareTarget"
                                         IsChecked="{Binding IsSelected}"
                                         Margin="0,0,0,4">
                              <StackPanel Orientation="Horizontal">
                                <controls:IconGlyph Data="{StaticResource Icon.Monitor}" Style="{StaticResource Icon.Small}" />
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                  </StackPanel>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Windows -->
        <ItemsControl ItemsSource="{Binding Windows}"
                      Visibility="{Binding HasTargets, Converter={StaticResource BoolToVisible}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton GroupName="ShareTarget"
                                         IsChecked="{Binding IsSelected}"
                                         Margin="0,0,0,4">
                              <StackPanel Orientation="Horizontal">
                                <controls:IconGlyph Data="{StaticResource Icon.ScreenShare}" Style="{StaticResource Icon.Small}" />
                  <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" />
                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                  </StackPanel>
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Capture options ===== -->
        <Border Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,12,0,0">
          <StackPanel>
            <CheckBox Content="共享时显示捕获边框"
                                  IsChecked="{Binding ShowCaptureBorder}"
                                  ToolTip="在共享的屏幕或窗口周围绘制系统高亮边框。Windows 10 始终绘制，仅 Windows 11 可关闭。" />
                        <CheckBox Content="捕获鼠标指针"
                                  IsChecked="{Binding CaptureCursor}"
                                  Margin="0,8,0,0"
                                  ToolTip="将鼠标指针包含在共享画面中。" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== Footer ===== -->
    <Border Grid.Row="2"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="14,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Button.Secondary}"
                Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
                Content="取消" />
        <Button Style="{StaticResource Button.Primary}"
                Margin="8,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="开始共享" />
      </StackPanel>
    </Border>
  </Grid>
</controls:ShellWindow>