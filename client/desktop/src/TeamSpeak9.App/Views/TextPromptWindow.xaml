<controls:ShellWindow x:Class="TeamSpeak9.App.Views.TextPromptWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
                      xmlns:controls="clr-namespace:TeamSpeak9.App.Controls"
                      xmlns:conv="clr-namespace:TeamSpeak9.App.Converters"
                      Width="420"
                      SizeToContent="Height"
                      ResizeMode="NoResize"
                      ShowInTaskbar="False"
                      WindowStartupLocation="CenterOwner">

  <controls:ShellWindow.Resources>
    <conv:EmptyToVisibilityConverter x:Key="EmptyToVisible" />
  </controls:ShellWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Same caption arrangement as the shell: Windows owns the strip, only the buttons opt back
         in to hit testing. -->
    <Grid Grid.Row="0"
          Height="{StaticResource Size.CaptionHeight}"
          Background="{StaticResource Brush.Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="TitleLabel"
                 Grid.Column="0"
                 Style="{StaticResource Text.Subtitle}"
                 VerticalAlignment="Center"
                 Margin="14,0,0,0" />

      <Button Grid.Column="1"
              Style="{StaticResource Button.CaptionClose}"
              Command="{x:Static sw:SystemCommands.CloseWindowCommand}"
              VerticalAlignment="Top"
              Margin="0,8,8,0"
              ToolTip="关闭">
        <controls:IconGlyph Data="{StaticResource Icon.Close}" Style="{StaticResource Icon.Small}" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Margin="18,10,18,14">
      <TextBlock x:Name="PromptLabel"
                 Style="{StaticResource Text.BodySecondary}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8" />

      <TextBox x:Name="ValueBox"
               Style="{StaticResource TextBox.Base}"
               MaxLength="255"
               TextChanged="OnValueChanged" />

      <TextBlock x:Name="ErrorLabel"
                 Style="{StaticResource Text.Caption}"
                 Foreground="{StaticResource Brush.Danger}"
                 TextWrapping="Wrap"
                 Margin="0,6,0,0"
                 Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyToVisible}}" />
    </StackPanel>

    <Border Grid.Row="2"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.BorderSubtle}"
            BorderThickness="0,1,0,0"
            Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- IsCancel alone closes with DialogResult=false, and it also wires up Esc. -->
        <Button Style="{StaticResource Button.Secondary}"
                Content="取消"
                IsCancel="True"
                MinWidth="88" />
        <Button x:Name="AcceptButton"
                Style="{StaticResource Button.Primary}"
                IsDefault="True"
                MinWidth="88"
                Margin="8,0,0,0"
                Click="OnAcceptClick" />
      </StackPanel>
    </Border>
  </Grid>
</controls:ShellWindow>
