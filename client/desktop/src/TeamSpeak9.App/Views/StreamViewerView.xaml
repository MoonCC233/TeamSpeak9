<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:TeamSpeak9.App.Views"
                    xmlns:vm="clr-namespace:TeamSpeak9.App.ViewModels"
                    xmlns:conv="clr-namespace:TeamSpeak9.App.Converters"
                    xmlns:ctrl="clr-namespace:TeamSpeak9.App.Controls">

  <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
  <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
  <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
  <conv:EmptyToVisibilityConverter x:Key="NullToVisibilityConverter" />
  <conv:NotConverter x:Key="NotConverter" />

    <!-- Stream list item template -->
    <DataTemplate DataType="{x:Type vm:StreamViewModel}">
        <Border Style="{StaticResource CardStyle}"
                Margin="8,4"
                Padding="12,8"
                ToolTip="{Binding ResolutionText}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

<!-- Stream type icon -->
                <ctrl:IconGlyph Data="{StaticResource Icon.ScreenShare}"
                            Grid.Column="0"
                            Width="24" Height="24"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Text.PrimaryBrush}"
                            Margin="0,0,12,0"/>

                <!-- Stream info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name, FallbackValue='未命名流'}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Text.PrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding PublisherName}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.SecondaryBrush}"/>
                        <TextBlock Text=" • "
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.MutedBrush}"/>
                        <TextBlock Text="{Binding ViewerCount, StringFormat='观众: {0}'}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.MutedBrush}"/>
                        <TextBlock Text=" • "
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.MutedBrush}"/>
                        <TextBlock Text="{Binding ResolutionText}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource Button.Secondary}"
                            Command="{Binding DataContext.SubscribeAsync, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsSubscribing, Converter={StaticResource InverseBoolConverter}}"
                            Visibility="{Binding IsSubscribed, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            Padding="12,6"
                            ToolTip="观看此流">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:IconGlyph Data="{StaticResource Icon.Play}" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="观看" Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Danger}"
                            Command="{Binding DataContext.UnsubscribeAsync, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding IsSubscribed, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="12,6"
                            ToolTip="停止观看">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:IconGlyph Data="{StaticResource Icon.Stop}" Width="14" Height="14" Margin="0,0,4,0"/>
                            <TextBlock Text="停止" Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                    </Button>

                    <ProgressBar Style="{StaticResource ProgressBar.Small}"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsSubscribing, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Width="80" Height="4"
                                 VerticalAlignment="Center"
                                 Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Stream viewer panel -->
    <DataTemplate DataType="{x:Type vm:StreamViewerViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}" Padding="8">
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                    <TextBlock Text="可观看的流" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource Button.Ghost}"
                            Command="{Binding RefreshAsync}"
                            IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBoolConverter}}"
                            Padding="8,4"
                            ToolTip="刷新列表">
<StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                        <ctrl:IconGlyph Data="{StaticResource Icon.Refresh}" Width="16" Height="16" Margin="0,0,4,0"
                                        RenderTransformOrigin="0.5,0.5"
                                        Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ctrl:IconGlyph.RenderTransform>
                                <RotateTransform/>
                            </ctrl:IconGlyph.RenderTransform>
                            <ctrl:IconGlyph.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                             From="0" To="360" Duration="0:0:1"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ctrl:IconGlyph.Triggers>
                        </ctrl:IconGlyph>
                        <ctrl:IconGlyph Data="{StaticResource Icon.Refresh}" Width="16" Height="16"
                                        Visibility="{Binding IsRefreshing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Text="刷新" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                    </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding RefreshError}"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Status.DangerBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding RefreshError, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Stream list -->
            <Border Grid.Row="1" Margin="8" Style="{StaticResource CardStyle}">
                <ListBox ItemsSource="{Binding Streams}"
                         SelectedItem="{Binding SelectedStream, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ListBoxItem.Transparent}"/>
            </Border>

            <!-- Active viewer -->
            <Border Grid.Row="2" Margin="8" Style="{StaticResource CardStyle}" MinHeight="300"
                    Visibility="{Binding ActiveViewer, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Viewer header -->
                    <Border Grid.Row="0" Style="{StaticResource ToolbarStyle}" Padding="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <TextBlock Text="{Binding SelectedStream.Name, FallbackValue='未命名流'}"
                                       Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedStream.Mode, StringFormat='模式: {0}'}"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Text.SecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedStream.ResolutionText}"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Text.MutedBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding ToggleFullscreen}"
                                    Padding="8,4"
                                    ToolTip="全屏">
                                <ctrl:IconGlyph Data="{StaticResource Icon.Fullscreen}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Video render area -->
                    <Border Grid.Row="1" Background="{DynamicResource Surface.LowBrush}"
                            ClipToBounds="True">
                        <Grid x:Name="VideoContainer">
                            <!-- Video frame will be rendered here via Image control -->
                            <Image x:Name="VideoImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            
                            <!-- Placeholder when no frame -->
                            <TextBlock Text="等待视频流..."
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{DynamicResource Text.MutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding CurrentFrame, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Viewer footer with stats -->
                    <Border Grid.Row="2" Style="{StaticResource ToolbarStyle}" Padding="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <ctrl:IconGlyph Data="{StaticResource Icon.Sliders}" Width="14" Height="14"
                                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                <TextBlock Text="统计信息" Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <ctrl:IconGlyph Data="{StaticResource Icon.Globe}" Width="14" Height="14"
                                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                                <TextBlock Text="连接中..." Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Text.SecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Empty state -->
            <Border Grid.Row="1" Grid.RowSpan="2" Margin="8" Style="{StaticResource CardStyle}"
                    Visibility="{Binding ActiveViewer, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,12,0">
                    <ctrl:IconGlyph Data="{StaticResource Icon.Monitor}" Width="64" Height="64"
                               Foreground="{DynamicResource Text.MutedBrush}"/>
                    <TextBlock Text="暂无可观看的流"
                               Style="{StaticResource Text.Subtitle}"
                               Foreground="{DynamicResource Text.SecondaryBrush}"/>
                    <TextBlock Text="当前频道没有正在进行的屏幕共享"
                               Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Text.MutedBrush}"
                               TextAlignment="Center"/>
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding RefreshAsync}"
                            Padding="16,8"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                            <ctrl:IconGlyph Data="{StaticResource Icon.Refresh}" Width="16" Height="16"/>
                            <TextBlock Text="刷新列表" Style="{StaticResource Text.Body}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>