<Application x:Class="TeamSpeak9.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Order matters: Palette declares every colour and metric the later dictionaries
           resolve with StaticResource, so it has to be merged first. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Palette.xaml" />
        <ResourceDictionary Source="Themes/Typography.xaml" />
        <ResourceDictionary Source="Themes/Icons.xaml" />
        <ResourceDictionary Source="Themes/Controls/Icons.xaml" />
        <ResourceDictionary Source="Themes/Controls/Buttons.xaml" />
        <ResourceDictionary Source="Themes/Controls/Inputs.xaml" />
        <ResourceDictionary Source="Themes/Controls/Lists.xaml" />
        <ResourceDictionary Source="Themes/Controls/Surfaces.xaml" />
        <ResourceDictionary Source="Themes/Controls/Markdown.xaml" />
        <ResourceDictionary Source="Themes/Window.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
