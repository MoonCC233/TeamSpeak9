<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <!-- Windows 10 2004 (19041) is the floor for the Windows SDK projection used by the
           streaming layer. -->
      <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
      <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
      <RootNamespace>TeamSpeak9.Streaming</RootNamespace>
      <AssemblyName>TeamSpeak9.Streaming</AssemblyName>
    </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TeamSpeak9.Core\TeamSpeak9.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- H.264 encoding. The NuGet packages carry only managed assemblies; the native FFmpeg 7.x
             binaries are staged by the host app (TeamSpeak9.App) from third_party/native/win-x64 into
             FFmpeg/bin/x64 and are optional - ScreenVideoEncoder falls back to the managed VP8 encoder
             when they are missing. -->
        <PackageReference Include="SIPSorcery" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" />
    <!-- Managed VP8 fallback; brings its own vpxmd.dll. -->
    <PackageReference Include="SIPSorceryMedia.Encoders" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" />
      </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TeamSpeak9.Streaming.Tests</_Parameter1>
    </AssemblyAttribute>
      <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
        <_Parameter1>TeamSpeak9.App</_Parameter1>
      </AssemblyAttribute>
    </ItemGroup>

</Project>
